---
const { label, title, linkHref, linkText } = Astro.props;
---

<div class="section__header">
  <div>
    <span class="section__label">{label}</span>
    <h2 class="section__title">{title}</h2>
  </div>
  {linkHref && linkText ? <a href={linkHref} class="section__link">{linkText}</a> : null}
</div>